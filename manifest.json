{
  "id": "/",
  "name": "MUSGO",
  "short_name": "MUSGO",
  "description": "Morfogénesis de Unidades y Sistemas Generativos Orgánicos",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#000000",
  "theme_color": "#000000",
  "icons": [
    {
      "src": "icons/resonant192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/resonant512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/resonant512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+musgo",
      "url": "./?musgo=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "name": "MUSGO Organism",
      "accept": {
        "application/vnd.musgo.organism+json": [".organism"],
        "application/json": [".organism"]
      },
      "icons": [
        {
          "src": "icons/resonant192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    },
    {
      "action": "./",
      "name": "USDZ model",
      "accept": {
        "model/vnd.usdz+zip": [".usdz"]
      },
      "icons": [
        {
          "src": "icons/resonant192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ]
}
